{
  "name": "dsh-ego-browser",
  "version": "0.8.6-dsh-remote.8",
  "description": "Isolated adaptation of upstream Ego Browser v0.8.6 for the reviewed DSH rc.2 fork: 25 scoped tools, Better Sidebar Browser mode, explicit human control, main Conversation continuation gate, and optional single-owner Cloudflare Access remote watching (see docs/DSH-REMOTE-ACCESS.md). Production Profile and OAuth acceptance remain separate gates.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./dsh-plugin.json": "./dsh-plugin.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "bin/",
    "runtime/",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "docs/DSH-RC2-ADAPTATION.md",
    "docs/DSH-REMOTE-ACCESS.md",
    "THIRD_PARTY_NOTICES.md",
    "!**/*.map"
  ],
  "dsh": {
    "engines": {
      "dsh": "0.1.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "build": "tsdown -c tsdown.config.ts"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.3",
    "jose": "6.2.3",
    "schemastery": "^3.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-connection": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "react": "^18.2.0",
    "schemastery": "^3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-settings": "link:../../p2/core/packages/settings/settings",
    "@deepseek-ai/dsh-tools": "link:../../p2/core/packages/core/tools",
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.31",
    "@types/ws": "^8.5.10",
    "jsdom": "^26.0.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fisfzy/dsh-ego-browser.git"
  }
}
