{
  "$schema": "https://dsh.community/schemas/dsh-plugin-0.15.json",
  "id": "dsh-ego-browser",
  "name": "ego-browser",
  "version": "0.8.6-dsh-remote.5",
  "manifestVersion": "0.15",
  "facets": {
    "host": {
      "entry": "lib/index.js",
      "apiVersion": "v1alpha1"
    }
  },
  "requires": {
    "contracts": [
      {
        "apiVersion": "presentation.dsh/v1alpha1",
        "kind": "OpenExternal",
        "optional": true,
        "fallback": "report the URL as text instead of opening it"
      },
      {
        "apiVersion": "presentation.dsh/v1alpha1",
        "kind": "Notification",
        "optional": true,
        "fallback": "log the notice to the browser-status scene"
      }
    ]
  },
  "permissions": [],
  "contributes": {
    "commands": [],
    "x-dsh-tui": [
      {
        "apiVersion": "tui.dsh/v1alpha1",
        "kind": "Scene",
        "id": "dsh-ego-browser.watch",
        "name": "agent_browser",
        "spec": {
          "title": "Agent 浏览器",
          "titles": {
            "en": "Agent Browser",
            "zh": "Agent 浏览器"
          }
        }
      },
      {
        "apiVersion": "tui.dsh/v1alpha1",
        "kind": "SettingsSection",
        "id": "dsh-ego-browser.settings",
        "name": "ego_browser_settings",
        "spec": {
          "namespace": "ego-browser",
          "title": "Agent 浏览器",
          "titles": {
            "en": "Agent Browser",
            "zh": "Agent 浏览器"
          },
          "fields": [
            {
              "path": [
                "isolateSpaces"
              ],
              "label": "任务空间沙盒隔离 (Space isolation)",
              "kind": "boolean",
              "hint": "仅在专用 Agent Chrome 内选择默认 cookie jar 或独立内存 context。任务页签归属与账号 cookie 隔离不同；真实登录和持久化重启尚未验收。"
            },
            {
              "path": [
                "idleTimeoutMin"
              ],
              "label": "空闲自动回收 (Idle auto-stop, minutes)",
              "kind": "number",
              "hint": "仅用于专用隔离运行时。0 关闭自动回收；冷启动时重新验证任务归属。已有登录持久化与运行时复用尚未验收。"
            },
            {
              "path": [
                "chromePath"
              ],
              "label": "Browser binary path",
              "kind": "text",
              "hint": "Path to the Chrome/Chromium/Edge binary. Empty = auto-detect."
            },
            {
              "path": [
                "captureBackend"
              ],
              "label": "Capture backend (rc.2 candidate: CDP only)",
              "kind": "select",
              "options": [
                {
                  "value": "cdp",
                  "label": "CDP"
                }
              ]
            },
            {
              "path": [
                "streamProfile"
              ],
              "label": "Quality profile",
              "kind": "select",
              "options": [
                {
                  "value": "balanced",
                  "label": "Balanced"
                },
                {
                  "value": "quality",
                  "label": "Quality"
                },
                {
                  "value": "speed",
                  "label": "Speed"
                }
              ]
            }
          ]
        }
      }
    ]
  },
  "subscriptions": [],
  "license": "MIT",
  "source": {
    "repository": "https://github.com/Fisfzy/dsh-ego-browser"
  },
  "compat": {
    "hosts": [
      "dsh-tui"
    ]
  }
}
